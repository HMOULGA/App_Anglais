{
  "name": "fluent",
  "productName": "Fluent",
  "version": "0.1.0",
  "description": "Tuteur d'anglais oral 100 % hors-ligne (IA locale)",
  "author": "Henri Moulga",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "electron": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "build": {
    "appId": "fr.hmoulga.fluent",
    "productName": "Fluent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "Fluent-portable-${version}.exe"
    }
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@huggingface/transformers": "^4.3.2",
    "@wllama/wllama": "^3.13.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "jsdom": "^31.0.1",
    "kokoro-js": "^1.2.1",
    "onnxruntime-web": "^1.31.0-dev.20260914-8d85527a0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "kokoro-js": {
      "@huggingface/transformers": "$@huggingface/transformers"
    }
  }
}
